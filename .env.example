# firma-mcp configuration. Copy to .env and fill in. Never commit .env.
#
# One installation serves ONE company. A module is enabled only when all of its
# variables are set; leave a section empty to keep that module off. The experimental
# Fakturownia module additionally needs FAKTUROWNIA_ENABLED=true.

# ----------------------------------------------------------------------------
# Server (required)
# ----------------------------------------------------------------------------

# Public address of this server, without a trailing slash and without /mcp.
# Must be https://. This is the address you type into Claude or ChatGPT (plus /mcp).
FIRMA_BASE_URL=https://mcp.example.com

# Used by docker-compose.yml (Caddy) to obtain a TLS certificate. Same host as above.
FIRMA_DOMAIN=mcp.example.com

# ----------------------------------------------------------------------------
# Authentication (required; the server refuses to start without it)
# ----------------------------------------------------------------------------

# "github" (default): OAuth sign-in through GitHub. Required for claude.ai and ChatGPT.
# "token":  one shared secret in the Authorization header. For testing and your own scripts.
FIRMA_AUTH_MODE=github

# --- github mode ---
# Create a GitHub OAuth app: GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:               the value of FIRMA_BASE_URL
#   Authorization callback URL: <FIRMA_BASE_URL>/auth/callback
# Then copy the Client ID and generate a client secret on the app's page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub logins (user names) allowed to use the server, comma separated.
# Anyone can sign in to a GitHub OAuth app; this list is what restricts access to you.
# An account that is not listed is refused. The server does not start with an empty list.
FIRMA_ALLOWED_GITHUB_LOGINS=

# Random secret that signs the server's own tokens and encrypts stored OAuth state.
# At least 32 characters. Generate with:  openssl rand -hex 32
# Changing it signs everyone out.
FIRMA_JWT_SIGNING_KEY=

# Optional: OAuth redirect URIs that clients may use, comma separated. The default
# allows claude.ai, ChatGPT and loopback addresses (Claude Code, MCP Inspector).
# FIRMA_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# --- token mode ---
# At least 32 characters. Generate with:  openssl rand -hex 32
# FIRMA_AUTH_TOKEN=

# ----------------------------------------------------------------------------
# Module: KSeF (Krajowy System e-Faktur), invoices received by the company
# ----------------------------------------------------------------------------

# KSeF token limited to reading invoices. Generate it in Aplikacja Podatnika KSeF 2.0
# (see https://ksef.podatki.gov.pl): sign in for your company, generate a token and select
# only the permission to browse invoices ("przeglądanie faktur"). Do not grant the
# permission to issue invoices. The token is shown once.
KSEF_TOKEN=
# Your company's NIP, 10 digits.
KSEF_NIP=
# "prod" (default) or "test" (the Ministry's test environment).
# KSEF_ENV=prod

# ----------------------------------------------------------------------------
# Module: Merit Aktiva / 360 Księgowość, booked invoices and payments
# ----------------------------------------------------------------------------

# API ID and API key from the API settings of your Merit Aktiva / 360 Księgowość account
# (vendor documentation: https://api.merit.ee/connecting-robots/reference-manual/).
# The same key could also write data, so keep it secret; this server only calls read
# endpoints.
MERIT_API_ID=
MERIT_API_KEY=
# "pl" (default, 360 Księgowość). "ee" and "fi" are untested.
# MERIT_COUNTRY=pl

# ----------------------------------------------------------------------------
# Module: mail (IMAP), read-only access to INBOX
# ----------------------------------------------------------------------------

# IMAP server (TLS, port 993 unless MAIL_PORT says otherwise).
MAIL_HOST=
# MAIL_PORT=993
# Mailboxes to expose, comma separated. Each address is also the IMAP login.
MAIL_BOXES=
# One password per mailbox. The variable name is MAIL_PASSWORD__ followed by the address
# with "@", "." and "-" replaced by "_". Example for office@example.com:
#   MAIL_PASSWORD__office_example_com=...
# Use an app password if your mail provider offers them.

# ----------------------------------------------------------------------------
# Module: Fakturownia (EXPERIMENTAL, never tested on a live account)
# ----------------------------------------------------------------------------

# Off by default. Unlike the other modules, filling in the credentials is not enough:
# the module starts only when this is set to true.
# FAKTUROWNIA_ENABLED=true

# Your account name: the first part of https://<name>.fakturownia.pl
FAKTUROWNIA_DOMAIN=
# In Fakturownia: Ustawienia > Ustawienia konta > Integracja > Kod autoryzacyjny API.
# The same token could also write data, so keep it secret; this server only sends GET
# requests.
FAKTUROWNIA_API_TOKEN=

# ----------------------------------------------------------------------------
# Advanced (optional)
# ----------------------------------------------------------------------------

# With KSeF and Merit both enabled, the server builds the booking history in the
# background at start-up (about 150 paced requests to Merit). Set to false to build it only
# when booking_suggestions is first called, e.g. when a second installation shares the
# same Merit API key and its limit of 100 requests per minute.
# FIRMA_WARM_HISTORY=true

# Address and port the server listens on. Keep it on localhost behind a reverse proxy.
# FIRMA_HOST=127.0.0.1
# FIRMA_PORT=8600
